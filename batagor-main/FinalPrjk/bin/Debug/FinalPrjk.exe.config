<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Ganti Data Source jika memakai SQL Server Express, mis. .\SQLEXPRESS -->
        <add name="BelanjaDb"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DbBelanjaKeluarga;Integrated Security=True;Connect Timeout=30"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
